{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dmv-blog",
	"account_id": "0880c9b1488acd73ee21d22224693618",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dmv-blog-db",
			"database_id": "37ffbae8-df7e-4a96-a764-0d5216f6b2ba"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "be92d99d54ff4b7cb01140c9532293cb"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "dmv-blog-media"
		}
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"]
	}
}
